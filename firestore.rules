rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Projects Collection
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // Invoices Collection
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    // Tickets Collection
    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // AI Agents Collection
    match /ai_agents/{agentId} {
      allow read, write: if true;
    }

    // AI Agent Logs Collection
    match /ai_agent_logs/{logId} {
      allow read, write: if true;
    }

    // Webhook Events Collection
    match /webhook_events/{eventId} {
      allow read, write: if true;
    }

    // Contact Messages Collection (Bandeja de Entrada)
    match /contact_messages/{messageId} {
      allow read, write: if true;
    }

    // AI Agent Chat Conversations Collection
    match /ai_agent_conversations/{conversationId} {
      allow read, write: if true;
    }
  }
}
